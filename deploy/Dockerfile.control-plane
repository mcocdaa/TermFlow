FROM ghcr.io/astral-sh/uv:0.11.19 AS uv

FROM node:22-bookworm-slim AS web

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/clients/web/package.json ./apps/clients/web/package.json
COPY packages/client-contracts/package.json ./packages/client-contracts/package.json
COPY packages/client-core/package.json ./packages/client-core/package.json
COPY packages/client-ui/package.json ./packages/client-ui/package.json
COPY packages/design-tokens/package.json ./packages/design-tokens/package.json

RUN npm ci

COPY tsconfig.base.json ./
COPY apps/clients/web ./apps/clients/web
COPY packages/client-contracts ./packages/client-contracts
COPY packages/client-core ./packages/client-core
COPY packages/client-ui ./packages/client-ui
COPY packages/design-tokens ./packages/design-tokens

RUN npm run build:web

FROM python:3.12-slim AS runtime

COPY --from=uv /uv /uvx /bin/

RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system termflow \
    && useradd --system --gid termflow --home-dir /app termflow

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages/protocol ./packages/protocol
COPY apps/control-plane ./apps/control-plane
COPY apps/node/pyproject.toml ./apps/node/pyproject.toml
COPY --from=web /workspace/apps/clients/web/dist /app/frontend-dist

RUN uv sync --frozen --no-dev --package termflow-control-plane \
    && mkdir -p /app/data /app/frontend-dist \
    && chown -R termflow:termflow /app

USER termflow

EXPOSE 8000

CMD ["uv", "run", "--frozen", "--no-dev", "--package", "termflow-control-plane", "termflow-control", "serve", "--host", "0.0.0.0", "--port", "8000"]
