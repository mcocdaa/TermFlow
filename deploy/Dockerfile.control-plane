FROM ghcr.io/astral-sh/uv:0.11.19 AS uv

FROM node:22-bookworm-slim AS web

WORKDIR /workspace

COPY apps/clients/web/package.json apps/clients/web/package-lock.json ./apps/clients/web/
COPY packages/design-tokens/package.json ./packages/design-tokens/package.json

RUN cd apps/clients/web && npm ci

COPY apps/clients/web ./apps/clients/web
COPY packages/design-tokens ./packages/design-tokens

RUN cd apps/clients/web && npm run build

FROM python:3.12-slim AS runtime

COPY --from=uv /uv /uvx /bin/

RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system termflow \
    && useradd --system --gid termflow --home-dir /app termflow

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY apps ./apps
COPY --from=web /workspace/apps/clients/web/dist /app/web

RUN uv sync --frozen --no-dev --package termflow-control-plane \
    && mkdir -p /app/data /app/web \
    && chown -R termflow:termflow /app

USER termflow

EXPOSE 8000

CMD ["uv", "run", "--frozen", "--no-dev", "--package", "termflow-control-plane", "termflow-control", "serve", "--host", "0.0.0.0", "--port", "8000"]
