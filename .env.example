# 必填。B 的初始管理员凭据，至少包含 32 个 UTF-8 字节。
# 生成：python -c 'import secrets; print(secrets.token_urlsafe(32))'
TERMFLOW_ADMIN_TOKEN=replace-with-generated-secret

# Durable v0.2.0 Compose 使用固定、可审计的卷名（见
# docs/runbooks/agent-broker-local.md），不提供环境变量覆盖。多套部署请使用明确的
# Compose project/override，不要把旧卷误当成当前实例的数据卷。

# 可选。宿主机 loopback 监听端口，默认 8765；仅在端口冲突时修改。
TERMFLOW_HOST_PORT=8765

# 反向代理部署必须修改。用户、Computer A、App 和 EXE 实际访问的外部服务网址。
# 本地保留 loopback；生产替换为不带路径的公网 HTTPS origin。
TERMFLOW_PUBLIC_BASE_URL=http://127.0.0.1:8765
# 仅允许 loopback HTTP 使用非 Secure 浏览器 Cookie；公网 HTTPS 部署应设为 false。
TERMFLOW_ALLOW_INSECURE_LOOPBACK=true

# 可选。信任反向代理追加的 X-Forwarded-For 进行认证限速计源；默认 false（只按
# 直连 IP 计源，反代部署下所有用户共享一个来源预算）。仅在代理保证追加并清洗
# X-Forwarded-For 时开启。
# TERMFLOW_TRUST_PROXY=false

# 可选。开放 /docs、/redoc 与 /openapi.json 契约页；默认 false 关闭。
# TERMFLOW_ENABLE_DOCS=false

# 可选。单 B 默认在 termflow-v020-local-totp-key 中自动创建并复用私有主密钥。
# 仅在多 B 共享密钥或明确管理密钥材料时设置；完成 2FA 绑定后不可直接更换。
# 生成：python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip("="))'
# TERMFLOW_TOTP_MASTER_KEY=replace-with-generated-base64url-key

# 浏览器 HttpOnly 会话有效期，单位秒；默认 28800，即 8 小时。
TERMFLOW_BROWSER_SESSION_TTL_SECONDS=28800
# B 内存中同时保留的浏览器会话上限，默认 4096；大量并发管理员会话时才调整。
TERMFLOW_BROWSER_SESSION_CAPACITY=4096
# 添加电脑生成的一次性注册码有效期，单位秒；默认 60，范围 10–600。
TERMFLOW_ENROLLMENT_TOKEN_TTL_SECONDS=60

# 单个浏览器终端输入帧上限，单位字节；默认 65536，即 64 KiB。
TERMFLOW_TERMINAL_MAX_FRAME_BYTES=65536
# 单个终端输入速率上限，单位字节/秒；默认 262144，即 256 KiB/s。
TERMFLOW_TERMINAL_INPUT_RATE_BYTES_PER_SECOND=262144
# 单个终端待发送队列消息上限，默认 256 条；过小会更早断开慢客户端。
TERMFLOW_TERMINAL_QUEUE_MAX_MESSAGES=256
# 单个终端待发送队列总字节上限，默认 1048576，即 1 MiB。
TERMFLOW_TERMINAL_QUEUE_MAX_BYTES=1048576
# 临时断网后允许原终端会话恢复的宽限期，单位秒；默认 30 秒。
TERMFLOW_TERMINAL_RESUME_GRACE_SECONDS=30

# ── Agent Broker：OpenCode 参考运行时（M4.3，plan §16）─────────────────────────
# opencode-agent 服务只挂在内部网络 agent_internal，不向宿主机发布 4096 端口。
# 以下变量必须来自部署机密（gitignored .env 或机密管理器导出的环境变量），
# 禁止提交真实值；镜像标签与摘要已固定为 M4 真实容器验证使用的精确 pin。
# 生成：python -c 'import secrets; print(secrets.token_urlsafe(32))'

# B 到 OpenCode 内部连接的 HTTP Basic 认证凭据（plan §16；镜像官方
# OPENCODE_SERVER_* 变量，M4 exit 实测），需定期轮换。
OPENCODE_SERVER_USERNAME=replace-with-deployment-secret
OPENCODE_SERVER_PASSWORD=replace-with-deployment-secret
# DeepSeek provider 凭据，经部署机密注入，绝不进入镜像层、OpenCode 配置文件
# 或日志。compose.agent-live.yaml 只使用 OpenCode 原生 {env:...} 引用。
DEEPSEEK_API_KEY=replace-with-deployment-secret
# 必填。OpenCode 调用 TermFlow MCP 时携带的 B 签发 AgentToken（管理 API 签发、
# 仅显示一次），经 OpenCode 原生 {env:} 配置插值注入 Authorization 头。
# 轮换 binding 时需同步更换；不得复用管理员、provider 或 cleanup token。
OPENCODE_AGENT_MCP_TOKEN=replace-with-deployment-secret
# 清理 helper 的独立 Bearer token；不能复用管理员 token 或 MCP capability。
TERMFLOW_AGENT_CLEANUP_HELPER_TOKEN=replace-with-deployment-secret
# 可选。OpenCode session 的容器内目录；参考 Compose 使用隔离的 /tmp tmpfs。
# 只有部署方显式挂载了专用 workspace 时才改成对应容器路径。
# TERMFLOW_AGENT_OPENCODE_DIRECTORY=/tmp

# ── Agent Broker：DeepSeek provider catalog policy ───────────────────────────
# 下面的字段由部署方依据账户/合同中可核验的 provider policy 填写，并由 B
# 生成 disclosure fingerprint。endpoint/model 是参考配置；region、retention
# 条款/版本、policy 版本和 no_training 必须有独立证据。当前公开资料不足以
# 替部署方证明 no-training，因此示例故意留空；没有证据时 preflight 会拒绝
# 启动（fail closed），不要把空值改成 true 来“通过”检查。
TERMFLOW_AGENT_PROVIDER_DEEPSEEK_ENDPOINT_ORIGIN=https://api.deepseek.com
TERMFLOW_AGENT_PROVIDER_DEEPSEEK_MODEL_IDS=deepseek-v4-flash
TERMFLOW_AGENT_PROVIDER_DEEPSEEK_REGION=
TERMFLOW_AGENT_PROVIDER_DEEPSEEK_RETENTION_TERMS=
TERMFLOW_AGENT_PROVIDER_DEEPSEEK_RETENTION_VERSION=
TERMFLOW_AGENT_PROVIDER_DEEPSEEK_NO_TRAINING=
TERMFLOW_AGENT_PROVIDER_DEEPSEEK_CREDENTIAL_SOURCE=DEEPSEEK_API_KEY
TERMFLOW_AGENT_PROVIDER_DEEPSEEK_POLICY_VERSION=

# durable Compose volumes have fixed names. Do not set legacy *_VOLUME
# variables: they no longer override a deployment and could mislead recovery.
# 可选。opencode 容器内存/CPU 上限，默认 2g / 2。
# OPENCODE_MEM_LIMIT=2g
# OPENCODE_CPUS=2

# ── Agent Broker：MCP 端点 DNS-rebinding 防护（plan §10/§16）──────────────────
# B 的 MCP Streamable HTTP 端点开启 DNS-rebinding 防护，默认只放行 loopback
# 来源（127.0.0.1:*,localhost:*,[::1]:*），面向非容器部署是安全默认值。
# 容器部署时 OpenCode 通过 agent_internal 内部网络以控制面容器名 + 8000 端口
# 访问该端点，必须显式命名该主机，否则每个 MCP 请求都会被 421 拒绝：
# TERMFLOW_AGENT_MCP_ALLOWED_HOSTS=control-plane:8000
# 多个主机用逗号分隔；条目格式为 host、host:port 或 host:*（IPv6 需加方括号）。
