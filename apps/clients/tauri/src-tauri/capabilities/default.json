{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum TermFlow native client capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:allow-open-url",
    "deep-link:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://localhost:*" },
        { "url": "http://[\\:\\:1]:*" }
      ]
    },
    "websocket:default",
    "os:default",
    "store:default",
    "clipboard-manager:allow-write-text"
  ]
}
