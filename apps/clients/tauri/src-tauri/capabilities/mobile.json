{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "TermFlow Android and iOS capabilities",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "deep-link:default",
    "os:default",
    "store:default",
    "clipboard-manager:allow-write-text"
  ]
}
